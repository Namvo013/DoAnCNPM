JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:5500
HEATMAP_GRID_SIZE_METERS=250
